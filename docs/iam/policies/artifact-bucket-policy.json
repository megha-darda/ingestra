{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyNonTlsRequests",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::ingestra-dev-sam-artifacts-ACCOUNT_ID-eu-central-1",
        "arn:aws:s3:::ingestra-dev-sam-artifacts-ACCOUNT_ID-eu-central-1/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
