{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateOnlyThisStacksChangeSetsWithApprovedRole",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:eu-central-1:ACCOUNT_ID:stack/ingestra-dev/*",
      "Condition": {
        "StringEquals": {
          "cloudformation:RoleArn": "arn:aws:iam::ACCOUNT_ID:role/ingestra-dev-cloudformation-execution",
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "AllowOnlyServerlessTransform",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet"
      ],
      "Resource": "arn:aws:cloudformation:eu-central-1:aws:transform/Serverless-2016-10-31",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ReviewAndExecuteThisStacksChangeSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResource",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:ListChangeSets",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:GetTemplate",
        "cloudformation:TagResource",
        "cloudformation:UntagResource"
      ],
      "Resource": "arn:aws:cloudformation:eu-central-1:ACCOUNT_ID:stack/ingestra-dev/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "ValidateInlineTemplates",
      "Effect": "Allow",
      "Action": [
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    },
    {
      "Sid": "PassOnlyTheCloudFormationExecutionRole",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/ingestra-dev-cloudformation-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "cloudformation.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadOnlyTheArtifactBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::ingestra-dev-sam-artifacts-ACCOUNT_ID-eu-central-1"
    },
    {
      "Sid": "ListOnlyThisStacksArtifactPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::ingestra-dev-sam-artifacts-ACCOUNT_ID-eu-central-1",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "ingestra-dev/",
            "ingestra-dev/*"
          ]
        }
      }
    },
    {
      "Sid": "UploadAndDeduplicateThisStacksArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::ingestra-dev-sam-artifacts-ACCOUNT_ID-eu-central-1/ingestra-dev/*"
    }
  ]
}
