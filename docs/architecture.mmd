flowchart TB
    accTitle: Ingestra - AWS serverless architecture
    accDescr: Amplify serves the React browser app. The browser calls an API Gateway HTTP API and uploads directly to private S3. An API Lambda starts three separate asynchronous Standard Step Functions workflows. Preview chooses one of two validator Lambdas. Import and rollback use a shared worker and conditional transactions across three DynamoDB tables. Supporting services are IAM, CloudWatch Logs, DynamoDB-managed KMS encryption, and SAM/CloudFormation deployment with a separate S3 artifact bucket.
    HOST["AWS Amplify Hosting<br/>React static frontend"]
    USER["Browser<br/>Review - approve - recover"]
    HOST -->|"HTTPS assets"| USER
    subgraph AWS["AWS backend - eu-central-1 - SAM stack: ingestra-dev"]
        API["Amazon API Gateway<br/>HTTP API"]
        HTTP["AWS Lambda<br/>ApiFunction<br/>API + upload URL signing"]
        subgraph SF["AWS Step Functions - STANDARD"]
            P["PreviewWorkflow<br/>Choice: inventory type"]
            I["ImportWorkflow<br/>Prepare - Inline Map - Finalize<br/>Concurrency: 5"]
            R["RollbackWorkflow<br/>Prepare - Inline Map - Finalize<br/>Concurrency: 5"]
        end
        V["AWS Lambda - 2 validators<br/>ElectronicsFunction<br/>GroceriesFunction"]
        W["AWS Lambda<br/>WorkerFunction<br/>Import + rollback tasks"]
        S3[("Amazon S3 - private bucket<br/>uploads/ - plans/<br/>outcomes/ - reports/<br/>SSE-S3; TLS required")]
        DB[("Amazon DynamoDB - 3 tables<br/>InventoryTable<br/>JobsTable<br/>JournalTable<br/>On-demand + PITR")]
        API -->|"Sync invoke"| HTTP
        HTTP -.->|"Async start: preview"| P
        HTTP -.->|"Async start: execute"| I
        HTTP -.->|"Async start: rollback"| R
        P -->|"Choose one validator Task"| V
        I -->|"Lambda Tasks"| W
        R -->|"Lambda Tasks"| W
        V -->|"Read upload; save plan"| S3
        V -->|"Read inventory; update job"| DB
        W -->|"Read plan; save outcomes / report"| S3
        W -->|"Conditional transactions:<br/>job check + inventory + journal"| DB
        HTTP -->|"Table reads; job claims / PATCH"| DB
        HTTP -->|"Read plans / reports"| S3
    end
    USER -->|"HTTPS JSON API<br/>GET / POST / PATCH + polling"| API
    USER -->|"Direct presigned PUT"| S3
